# ---------------------------------------------------------------------------
# Required. The server refuses to start without these and tells you which.
# ---------------------------------------------------------------------------

# Absolute, no trailing slash. Used to build links in email.
BASE_URL=http://localhost:3000

DATABASE_URL=postgres://workwiki:workwiki@db:5432/workwiki

# 64 hex characters each. Generate with: openssl rand -hex 32
# SESSION_SECRET keys session and IP pseudonymisation.
# ENCRYPTION_KEY encrypts TOTP secrets and the stored SMTP password.
SESSION_SECRET=
ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Object storage. Defaults match the MinIO service in docker-compose.yml.
# ---------------------------------------------------------------------------
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=workwiki
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# ---------------------------------------------------------------------------
# Optional.
# ---------------------------------------------------------------------------

# Run migrations automatically at boot. Set false to run `npm run migrate`
# yourself as a separate deploy step.
MIGRATE_ON_BOOT=true

# Argon2id cost. Defaults are the OWASP floor; raise on capable hardware.
# Raising them is safe: existing hashes are transparently upgraded on login.
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# The AI assistant is off by default and ships with no credentials.
ASSISTANT_ENABLED=false

# SMTP may also be set in the setup wizard, which sends a mandatory test.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Set true ONLY when running behind a proxy you control that sets
# X-Forwarded-For. Otherwise a client can spoof its own IP and defeat the
# rate limiter.
TRUST_PROXY=false
