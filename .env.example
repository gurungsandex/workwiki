# ---------------------------------------------------------------------------
# Three values are required. The server validates this file's shape before it
# listens, and exits naming the variable, the expected shape and an example.
# ---------------------------------------------------------------------------

# Where employees reach this deployment. HTTPS in production: session cookies
# use the __Host- prefix and Secure flag when this is https.
APP_BASE_URL=http://localhost:3000

# Postgres 16.
DATABASE_URL=postgres://workwiki:change-me@db:5432/workwiki

# openssl rand -base64 48
SESSION_SECRET=

# ---------------------------------------------------------------------------
# Object store. MinIO in Compose; any S3 API elsewhere. The bucket is private —
# every file is served through an access-checked route, never a public URL.
# ---------------------------------------------------------------------------
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=workwiki
S3_ACCESS_KEY_ID=workwiki
# openssl rand -base64 24
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# Postgres container credentials (docker compose only).
POSTGRES_USER=workwiki
POSTGRES_PASSWORD=
POSTGRES_DB=workwiki

# ---------------------------------------------------------------------------
# Mail. Invitations, verification and password resets need it; the setup
# wizard makes you test it before you invite anybody.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM=handbook@example.com

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Encrypts TOTP secrets at rest. openssl rand -base64 32
ENCRYPTION_KEY=

# Run migrations on boot. Set false if your operator prefers `npm run migrate`.
MIGRATE_ON_BOOT=true

# Trust X-Forwarded-For. Only true behind a proxy you control.
TRUST_PROXY=true

# Argon2id parameters. Raising them rehashes each password on next sign-in.
ARGON2_MEMORY_KIB=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1

# The assistant ships off. No pgvector index exists until it is turned on.
ASSISTANT_ENABLED=false

LOG_LEVEL=info
BUILD_ID=dev
APP_PORT=3000
