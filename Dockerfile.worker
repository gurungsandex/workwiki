# syntax=docker/dockerfile:1

# The worker image carries Tesseract, which the web image deliberately does not:
# OCR is CPU-heavy and belongs off the request path (spec §5).
FROM node:22-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      tini ca-certificates tesseract-ocr tesseract-ocr-eng \
 && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force

COPY --chown=node:node lib     ./lib
COPY --chown=node:node worker  ./worker
COPY --chown=node:node scripts ./scripts

USER node
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["node_modules/.bin/tsx", "worker/index.ts"]
